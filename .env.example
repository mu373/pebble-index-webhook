# Public Pebble webhook credential.
WEBHOOK_TOKEN=replace-with-a-long-random-value

# Preferred configuration: copy targets.example.yaml to targets.yaml.
TARGETS_CONFIG_PATH=./targets.yaml

# Secrets named by token_env or url_env in targets.yaml remain in the environment.
RECEIVER_TOKEN=
SLACK_WEBHOOK_URL=
EXAMPLE_WEBHOOK_TOKEN=

# Legacy personal-agent-gateway configuration.
GATEWAY_TOKEN=

# Routing hints sent in the normalized event envelope.
PEBBLE_SENDER_ID=
PEBBLE_CONVERSATION_ID=personal
PEBBLE_LANGUAGE_HINT=ja

DATA_DIR=./data
MAX_AUDIO_BYTES=26214400
WORKERS=1
